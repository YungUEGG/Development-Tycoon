using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI; // ★ 추가됨: Button 컴포넌트를 사용하기 위해 필수입니다!
using TMPro;

[System.Serializable]
public class SlotUI
{
    public TextMeshProUGUI nameText;
    public TextMeshProUGUI levelText;
    public TextMeshProUGUI gradeText;
    public TextMeshProUGUI incomeText;
    public Button playButton; // ★ 복구됨: 미니게임 플레이 버튼 연결칸 추가
}

public class GameUIManager : MonoBehaviour
{
    [Header("연결할 매니저")]
    public GameSlotManager slotManager; 
    public MiniGameManager miniGameManager; // ★ 복구됨: 미니게임 실행을 위해 연결칸 추가

    [Header("상단 UI")]
    public TextMeshProUGUI topGoldText;
    public TextMeshProUGUI topGoldPerSecText;

    [Header("새 게임 기획 UI 연결 (누락 복구!)")]
    public Button newGameButton;       // + 새 게임 기획하기 버튼
    public GameObject developUIPanel;  // 켜질 기획(조합) 창

    [Header("슬롯 UI 리스트 (27개 연결 필요)")]
    public List<SlotUI> slotUIs = new List<SlotUI>();

    void OnEnable()
    {
        if (slotManager != null)
        {
            slotManager.onSlotUpdated += RefreshUI;
        }
    }

    void OnDisable()
    {
        if (slotManager != null)
        {
            slotManager.onSlotUpdated -= RefreshUI;
        }
    }

    void Start()
    {
        // ★ 추가됨: 버튼을 클릭하면 OpenDevelopUI 함수가 실행되도록 연결합니다.
        if (newGameButton != null)
        {
            newGameButton.onClick.AddListener(OpenDevelopUI);
        }

        // ★ 복구됨: 각 슬롯의 플레이 버튼에 클릭 이벤트 연결
        for (int i = 0; i < slotUIs.Count; i++)
        {
            int index = i; // 람다 함수 오류 방지용 변수
            if (slotUIs[i].playButton != null)
            {
                slotUIs[i].playButton.onClick.AddListener(() => OnPlayButtonClicked(index));
            }
        }

        RefreshUI(); 
    }

    // 새 게임 기획 창 띄우기
    public void OpenDevelopUI()
    {
        if (developUIPanel != null)
        {
            developUIPanel.SetActive(true);
        }
    }

    // 화면의 글자들을 최신 데이터로 바꿔주는 함수
    public void RefreshUI()
    {
        if (slotManager == null) return;

        // 1. 상단 재화 표시 업데이트
        if (topGoldText != null) topGoldText.text = FormatNumber(slotManager.currentGold);
        if (topGoldPerSecText != null) topGoldPerSecText.text = "+" + FormatNumber(slotManager.currentGoldPerSec) + "/초";

        // 2. 각 슬롯 UI 업데이트
        for (int i = 0; i < slotManager.slots.Count; i++)
        {
            if (i >= slotUIs.Count) break; 

            GameData data = slotManager.slots[i];
            
            // ★ 복구됨: 일단 매번 새로고침 할 때마다 플레이 버튼은 기본으로 꺼둡니다.
            if (slotUIs[i].playButton != null) slotUIs[i].playButton.gameObject.SetActive(false);
            
            // 데이터가 없거나, 아직 잠긴 슬롯 처리
            if (data == null || string.IsNullOrEmpty(data.gameName))
            {
                if (slotUIs[i].nameText != null) slotUIs[i].nameText.text = "빈 슬롯";
                if (slotUIs[i].levelText != null) slotUIs[i].levelText.text = "";
                if (slotUIs[i].gradeText != null) slotUIs[i].gradeText.text = "";
                if (slotUIs[i].incomeText != null) slotUIs[i].incomeText.text = "";
                continue;
            }

            // 개발 중인 상태 표시 처리
            if (data.gameName == "개발 중...")
            {
                if (slotUIs[i].nameText != null) slotUIs[i].nameText.text = "<color=#FFFF00>기획서 작성중...</color>";
                if (slotUIs[i].levelText != null) slotUIs[i].levelText.text = "";
                if (slotUIs[i].gradeText != null) slotUIs[i].gradeText.text = "";
                if (slotUIs[i].incomeText != null) slotUIs[i].incomeText.text = "곧 완성됩니다!";
                continue;
            }

            // 완성된 게임 표시 처리
            if (slotUIs[i].nameText != null) slotUIs[i].nameText.text = data.gameName;
            
            // ★ 수정됨: 파닥파닥 새 또는 달려라 공룡이 슬롯에 있으면 플레이 버튼 켜기
            if ((data.gameName == "파닥파닥 새" || data.gameName == "달려라 공룡") && slotUIs[i].playButton != null)
            {
                slotUIs[i].playButton.gameObject.SetActive(true);
            }
            
            // ★ 수정됨: Lv 표시 대신 소프트웨어 버전(Ver) 형식으로 표기합니다!
            if (slotUIs[i].levelText != null) 
            {
                // 기본 레벨 1을 Ver 1.00 으로 맞추기 위한 계산식
                int baseLevel = data.level - 1; 
                int majorVer = 1 + (baseLevel / 100); // 앞자리 (1부터 시작)
                int minorVer = baseLevel % 100;       // 뒷자리 (0~99)
                
                // 00 형식으로 두 자리 고정 출력 (예: 1.05, 2.10)
                slotUIs[i].levelText.text = $"Ver {majorVer}.{minorVer:D2}";
            }
            
            if (slotUIs[i].gradeText != null)
            {
                slotUIs[i].gradeText.text = data.grade + " 급";
                
                // 등급에 따라 글자 색상 변경!
                switch (data.grade)
                {
                    case "SSS": slotUIs[i].gradeText.color = Color.cyan; break;
                    case "A": slotUIs[i].gradeText.color = Color.yellow; break;
                    case "C": slotUIs[i].gradeText.color = new Color(1f, 0.5f, 0f); break; // 주황색
                slotUIs[i].gradeText.color = Color.white; break;
                }
            }

            // 해당 슬롯의 현재 수익 계산해서 표시 (오류 해결됨!)
            float gradeMult = GetGradeMultiplier(data.grade);
            
            // ★ 수정됨: 삭제된 positionMult를 계산식에서 빼고, 대신 새로 추가된 globalIncomeMultiplier를 적용합니다.
            double income = data.baseGoldPerSec * (1 + (data.level * 0.1f)) * gradeMult * slotManager.globalIncomeMultiplier;

            if (slotUIs[i].incomeText != null)
            {
                slotUIs[i].incomeText.text = FormatNumber(income) + " /초";
            }
        }
    }

    // 등급별 수익 배율 계산 함수
    private float GetGradeMultiplier(string grade)
    {
        switch (grade)
        {
            case "SSS": return 2.0f;
            case "SS": return 1.75f;
            case "S": return 1.6f;
            case "A": return 1.5f;
            case "B": return 1.25f;
            case "C": return 1.0f;
            case "D": return 0.95f;
            case "E": return 0.9f;
            case "F": return 0.8f;
            default: return 1.0f;
        }
    }

    // 큰 숫자를 K, M, B, T 등의 가독성 좋은 단어로 변환해 주는 함수입니다.
    private string FormatNumber(double num)
    {
        if (num < 1000) return num.ToString("0");
        
        string[] suffixes = { "", "K", "M", "B", "T", "Qa", "Qi" };
        int suffixIndex = (int)(System.Math.Log10(num) / 3); 
        
        if (suffixIndex >= suffixes.Length) suffixIndex = suffixes.Length - 1;

        double scaledNum = num / System.Math.Pow(1000, suffixIndex);
        return scaledNum.ToString("0.00") + suffixes[suffixIndex];
    }

    // ★ 복구됨: 플레이 버튼을 눌렀을 때 실행될 함수
    public void OnPlayButtonClicked(int slotIndex)
    {
        if (slotManager == null || slotIndex >= slotManager.slots.Count) return;
        
        GameData data = slotManager.slots[slotIndex];

        // 파닥파닥 새 게임일 때
        if (data != null && data.gameName == "파닥파닥 새")
        {
            if (miniGameManager != null)
            {
                miniGameManager.OpenFlappyBird();
            }
            else
            {
                Debug.LogWarning("미니게임 매니저가 연결되지 않았습니다! (인스펙터 확인)");
            }
        }
        // ★ 추가됨: 달려라 공룡 게임일 때
        else if (data != null && data.gameName == "달려라 공룡")
        {
            if (miniGameManager != null)
            {
                miniGameManager.OpenDinoRun();
            }
            else
            {
                Debug.LogWarning("미니게임 매니저가 연결되지 않았습니다! (인스펙터 확인)");
            }
        }
    }
}
